// Re-apply the GPU Upscale jellyfin-web hook after any package operation, so a jellyfin-web
// upgrade does not silently drop the "Upscaled" entries from the player's quality menu.
DPkg::Post-Invoke { "if [ -x /usr/local/sbin/jellyfin-gpuupscale-webinject ]; then /usr/local/sbin/jellyfin-gpuupscale-webinject >/dev/null 2>&1 || true; fi"; };
