// Re-apply the Jellyfin Plus jellyfin-web hook after any package operation, so a jellyfin-web
// upgrade does not silently drop the Jellyfin Plus client script (the "Upscaled" quality-menu
// entries, the library filter additions and the other client-side patches).
// Before dpkg runs, hand config.json (a jellyfin-web conffile the theme entry edits) back to its
// packaged bytes, so an upgrade never stops at a "modified conffile" prompt; Post-Invoke re-adds it.
DPkg::Pre-Invoke { "if [ -x /usr/local/sbin/jellyfin-plus-webinject ]; then /usr/local/sbin/jellyfin-plus-webinject --restore-conffile >/dev/null 2>&1 || true; fi"; };
DPkg::Post-Invoke { "if [ -x /usr/local/sbin/jellyfin-plus-webinject ]; then /usr/local/sbin/jellyfin-plus-webinject >/dev/null 2>&1 || true; fi"; };
