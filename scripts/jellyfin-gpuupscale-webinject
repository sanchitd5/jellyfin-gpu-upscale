#!/bin/bash
# Re-applies the GPU Upscale hook to jellyfin-web.
#
# jellyfin-web is a package-owned static tree, so upgrading the jellyfin-web package replaces
# index.html and deletes gpu-upscale.js, silently removing the "Upscaled" entries from the player's
# quality menu. That fails safe (playback keeps working, nothing is upscaled unless the server
# plugin is set to RequireClientOptIn = false); run this script again to restore it. The apt hook
# in /etc/apt/apt.conf.d/99-jellyfin-gpuupscale runs it automatically after package operations.
set -eu

WEB=/usr/share/jellyfin/web
SRC=/usr/lib/jellyfin-gpuupscale/gpu-upscale.js

# Bumped whenever gpu-upscale.js changes, so a browser holding an older copy re-fetches it.
VERSION=17
TAG="<script defer=\"defer\" src=\"gpu-upscale.js?v=$VERSION\"></script>"

[ -f "$SRC" ] || { echo "gpu-upscale: source $SRC missing, nothing to do"; exit 0; }
[ -f "$WEB/index.html" ] || { echo "gpu-upscale: $WEB/index.html missing, nothing to do"; exit 0; }

# One pristine backup, taken the first time only.
[ -f "$WEB/index.html.gpuupscale-orig" ] || cp -a "$WEB/index.html" "$WEB/index.html.gpuupscale-orig"

install -m 0644 "$SRC" "$WEB/gpu-upscale.js"

if grep -q "gpu-upscale.js?v=$VERSION" "$WEB/index.html"; then
    echo "gpu-upscale: index.html already hooked at v$VERSION"
    exit 0
fi

cp -a "$WEB/index.html" "$WEB/index.html.gpuupscale-bak"

# Injected as the first script in <head> so the webpack chunk hook is in place before any chunk
# loads, whichever order the deferred bundles run in. An older tag is replaced in place.
python3 - "$WEB/index.html" "$TAG" <<'PYEOF'
import re
import sys

path, tag = sys.argv[1], sys.argv[2]
html = open(path).read()
html, replaced = re.subn(r'<script[^>]*src="gpu-upscale\.js[^"]*"[^>]*></script>', tag, html)
if replaced == 0:
    i = html.index('<script defer="defer"')
    html = html[:i] + tag + html[i:]

open(path, 'w').write(html)
PYEOF
echo "gpu-upscale: index.html hooked at v$VERSION"
