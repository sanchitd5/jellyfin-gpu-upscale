 doc/filters.texi              |  67 ++++++++
 libavfilter/Makefile          |   1 +
 libavfilter/allfilters.c      |   1 +
 libavfilter/vf_truehdr_cuda.c | 362 ++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 432 insertions(+)

