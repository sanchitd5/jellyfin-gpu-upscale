 doc/filters.texi               |  71 ++++++++
 libavfilter/Makefile           |   1 +
 libavfilter/allfilters.c       |   1 +
 libavfilter/vf_dlpp_drv_cuda.c | 370 +++++++++++++++++++++++++++++++++++++++++
 5 files changed, 444 insertions(+)

