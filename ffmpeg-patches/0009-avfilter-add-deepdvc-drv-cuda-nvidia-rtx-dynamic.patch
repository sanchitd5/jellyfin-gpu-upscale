 doc/filters.texi                  |  46 ++++++
 libavfilter/Makefile              |   1 +
 libavfilter/allfilters.c          |   1 +
 libavfilter/vf_deepdvc_drv_cuda.c | 300 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 349 insertions(+)

