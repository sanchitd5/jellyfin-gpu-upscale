 doc/filters.texi              |  77 ++++++++++
 libavfilter/Makefile          |   1 +
 libavfilter/allfilters.c      |   1 +
 libavfilter/vf_vsr_drv_cuda.c | 350 ++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 430 insertions(+)

