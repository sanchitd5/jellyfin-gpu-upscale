 doc/filters.texi          |  35 +++++
 libavfilter/Makefile      |   1 +
 libavfilter/allfilters.c  |   1 +
 libavfilter/vf_isr_cuda.c | 343 ++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 381 insertions(+)

