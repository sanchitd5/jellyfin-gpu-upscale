new file mode 100644
index 0000000000..57d047600d
--- /dev/null
+++ b/libavfilter/rtx_cuda.h
@@ -0,0 +1,498 @@
+/*
+ * Shared core for the NVIDIA RTX Video CUDA filters.
+ *
+ * This file is part of FFmpeg.
+ *
