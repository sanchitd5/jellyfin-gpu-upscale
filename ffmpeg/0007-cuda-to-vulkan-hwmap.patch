--- a/libavutil/hwcontext_vulkan.c
+++ b/libavutil/hwcontext_vulkan.c
@@ -3206,6 +3206,20 @@
 
 static int vulkan_get_buffer(AVHWFramesContext *hwfc, AVFrame *frame)
 {
+    /* A frames context this project derives INTO Vulkan (hwmap=derive_device=vulkan)
+     * can have hwfc->format baked in wrong at construction: av_hwframe_ctx_create_derived()
+     * sets it from the calling outlink's format field (libavfilter/vf_hwmap.c's
+     * config_output), and for a chained hwmap=derive_device=vulkan feeding a second
+     * hwmap=derive_device=cuda, that field still reads the upstream (CUDA) format at the
+     * one-time static-config moment config_output runs at -- forcing it there was tried
+     * and breaks that same config_output's own inlink/hwfc format-agreement check for the
+     * *next* hwmap in the chain, which reads this field at that same early moment and
+     * legitimately expects it to still match. This frame, unlike hwfc->format, is always
+     * really AV_PIX_FMT_VULKAN (set two lines up) -- correcting hwfc->format here, on every
+     * real buffer allocation rather than at construction, lands strictly after all static
+     * config has already run and strictly before any frame is actually mapped, so it fixes
+     * av_hwframe_map()'s later format-agreement check (which needs the true, current value)
+     * without disturbing the construction-time one (see livetestbox.md). */
     frame->buf[0] = av_buffer_pool_get(hwfc->pool);
     if (!frame->buf[0])
         return AVERROR(ENOMEM);
@@ -3215,6 +3229,8 @@
     frame->width   = hwfc->width;
     frame->height  = hwfc->height;
 
+    hwfc->format = AV_PIX_FMT_VULKAN;
+
     return 0;
 }
 
@@ -4089,6 +4105,37 @@
         else
             return AVERROR(ENOSYS);
 #endif
+#if CONFIG_CUDA
+    case AV_PIX_FMT_CUDA: {
+        /* Mirror of 0006's Vulkan->CUDA case in vulkan_map_from(), the other direction.
+         * dst->hw_frames_ctx here (== hwfc) is hwmap's auto-derived context, which
+         * av_hwframe_ctx_init() never runs frames_init() on (the derived contract assumes
+         * a view over the source's own memory, true for the DRM/VAAPI cases above, not
+         * here) -- so this lazily runs Vulkan's own frames_init()/frames_get_buffer()
+         * the first time this context is used, exactly as the reverse direction already
+         * does. vulkan_transfer_data_from_cuda() (above) is the existing, already-wired
+         * transfer primitive normally reached only via av_hwframe_transfer_data(); this
+         * reuses it as a real device-to-device cuMemcpy2DAsync, not true zero-copy, for
+         * the same reason 0006 gives: CUDA and Vulkan cannot alias the same memory here,
+         * only copy device-to-device with no host round trip. */
+        FFHWFramesContext *hwfci = ffhwframesctx(hwfc);
+        int err;
+
+        if (!hwfc->pool && !hwfci->pool_internal) {
+            err = hwfci->hw_type->frames_init(hwfc);
+            if (err < 0)
+                return err;
+        }
+        if (!hwfc->pool && hwfci->pool_internal)
+            hwfc->pool = hwfci->pool_internal;
+
+        err = hwfci->hw_type->frames_get_buffer(hwfc, dst);
+        if (err < 0)
+            return err;
+
+        return vulkan_transfer_data_from_cuda(hwfc, dst, src);
+    }
+#endif
     default:
         return AVERROR(ENOSYS);
     }
@@ -4911,6 +4958,48 @@
 static int vulkan_frames_derive_to(AVHWFramesContext *dst_fc,
                                    AVHWFramesContext *src_fc, int flags)
 {
+    /* av_hwframe_ctx_create_derived() calls this BEFORE the derived context's
+     * first frame ever reaches vulkan_map_to()'s AV_PIX_FMT_CUDA case above --
+     * libavfilter/vf_hwmap.c's config_output calls av_hwframe_ctx_init() right
+     * after create_derived(), which runs frames_init() through this hook, so
+     * by the time any frame arrives the pool already exists and that case's
+     * own (now dead) lazy-init branch never fires. This is therefore the
+     * actual place to force AV_VK_FRAME_FLAG_DISABLE_MULTIPLANE for a pool
+     * being derived FROM a CUDA source -- confirmed nb_images==1 combined
+     * multi-planar nv12 images are what vulkan_export_to_cuda() can't
+     * reliably export (CUDA_ERROR_INVALID_VALUE / segfault, see
+     * livetestbox.md); AV_VK_FRAME_FLAG_DISABLE_MULTIPLANE's own doc comment
+     * already says as much ("required to export/import images from CUDA").
+     * A pool this project derives FROM Vulkan TO somewhere else (unaffected --
+     * this hook only runs for derivation INTO Vulkan) or from any non-CUDA
+     * source keeps the driver's normal default. */
+    if (src_fc->device_ctx->type == AV_HWDEVICE_TYPE_CUDA) {
+        AVVulkanFramesContext *vkfc = dst_fc->hwctx;
+        vkfc->flags |= AV_VK_FRAME_FLAG_DISABLE_MULTIPLANE;
+
+        /* This pool's frames are real, independent device-to-device copies
+         * (vulkan_transfer_data_from_cuda), never true zero-copy views/aliases of
+         * the source CUDA frame -- unlike DRM_PRIME/VAAPI derivations, which this
+         * same hook also serves and where source_frames legitimately backs a real
+         * unmap-to-original-frame shortcut. av_hwframe_ctx_create_derived()
+         * unconditionally sets dsti->source_frames = ref(source_frame_ctx) right
+         * before calling this hook, on that view/alias assumption -- true for
+         * DRM/VAAPI, false here. Confirmed by a real gdb backtrace: chaining a
+         * second hwmap=derive_device=cuda after this one segfaults in
+         * av_buffer_ref() on a garbage pointer, because av_hwframe_ctx_create_derived()'s
+         * own "this is actually an unmapping" fast path (hwcontext.c) sees this
+         * pool's source_frames chain back to a frames context whose device_ctx
+         * identity-matches the second hwmap's freshly-derived CUDA device (both are
+         * the same physical GPU via primary-context retain), hands back a bare ref to
+         * that original CUDA frames context, and then av_hwframe_map()'s matching
+         * "is this an unmap" check (hwcontext.c) reads src->buf[0]->data as an
+         * HWMapDescriptor* -- but our frames were never wrapped via
+         * ff_hwframe_map_create(), so buf[0] is a real Vulkan-backed AVBufferRef, and
+         * the misread crashes. Clearing source_frames here removes the false premise
+         * at its root: without it, neither shortcut can match, and a later hwmap back
+         * to CUDA correctly takes vulkan_map_from()'s real CUDA case (0006) instead. */
+        av_buffer_unref(&ffhwframesctx(dst_fc)->source_frames);
+    }
     return vulkan_frames_init(dst_fc);
 }
 
