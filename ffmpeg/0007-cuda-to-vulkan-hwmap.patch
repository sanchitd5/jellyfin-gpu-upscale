--- a/libavutil/hwcontext_vulkan.c	2026-09-24 19:00:00
+++ b/libavutil/hwcontext_vulkan.c	2026-09-24 19:05:20
@@ -4084,6 +4084,60 @@
         else
             return AVERROR(ENOSYS);
 #endif
+#if CONFIG_CUDA
+    case AV_PIX_FMT_CUDA: {
+        /* Mirror of 0006's Vulkan->CUDA case in vulkan_map_from(), the other direction.
+         * dst->hw_frames_ctx here (== hwfc) is hwmap's auto-derived context, which
+         * av_hwframe_ctx_init() never runs frames_init() on (the derived contract assumes
+         * a view over the source's own memory, true for the DRM/VAAPI cases above, not
+         * here) -- so this lazily runs Vulkan's own frames_init()/frames_get_buffer()
+         * the first time this context is used, exactly as the reverse direction already
+         * does. vulkan_transfer_data_from_cuda() (above) is the existing, already-wired
+         * transfer primitive normally reached only via av_hwframe_transfer_data(); this
+         * reuses it as a real device-to-device cuMemcpy2DAsync, not true zero-copy, for
+         * the same reason 0006 gives: CUDA and Vulkan cannot alias the same memory here,
+         * only copy device-to-device with no host round trip. */
+        FFHWFramesContext *hwfci = ffhwframesctx(hwfc);
+        int err;
+
+        if (!hwfc->pool && !hwfci->pool_internal) {
+            /* Force one VkImage per plane instead of a combined multi-planar
+             * image. AV_VK_FRAME_FLAG_DISABLE_MULTIPLANE's own doc comment
+             * already says this is "required to export/import images from
+             * CUDA" -- confirmed the hard way: with a combined nv12 image,
+             * vulkan_export_to_cuda()'s multi-plane fallback (offsets via
+             * VK_IMAGE_ASPECT_MEMORY_PLANE_x_BIT_EXT) hands
+             * cuExternalMemoryGetMappedMipmappedArray a layout it can't
+             * actually use: CUDA_ERROR_INVALID_VALUE on a plain
+             * hwupload+hwmap chain, a segfault a few frames later on this
+             * bridged one. The device-level `disable_multiplane=1` device
+             * option fixes the same bug for a real -init_hw_device vulkan=
+             * instance (verified directly), but this pool is auto-derived
+             * with no such device string to attach an option to, so the
+             * frames-level flag has to be forced here instead. yuv420p
+             * (3 single-plane images already) was never affected -- Vulkan
+             * only packs a combined image for formats it CAN represent as
+             * one, i.e. semiplanar ones like nv12/p010le, which is also
+             * exactly the NVDEC-native format family this bridge exists to
+             * carry. See livetestbox.md for the CLI-flag proof this is
+             * built on and the real repro this fixes. */
+            AVVulkanFramesContext *vkfc = hwfc->hwctx;
+            vkfc->flags |= AV_VK_FRAME_FLAG_DISABLE_MULTIPLANE;
+
+            err = hwfci->hw_type->frames_init(hwfc);
+            if (err < 0)
+                return err;
+        }
+        if (!hwfc->pool && hwfci->pool_internal)
+            hwfc->pool = hwfci->pool_internal;
+
+        err = hwfci->hw_type->frames_get_buffer(hwfc, dst);
+        if (err < 0)
+            return err;
+
+        return vulkan_transfer_data_from_cuda(hwfc, dst, src);
+    }
+#endif
     default:
         return AVERROR(ENOSYS);
     }
